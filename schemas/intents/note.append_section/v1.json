{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/intents/note.append_section/v1.json",
  "additionalProperties": false,
  "description": "Append a section, under a heading, to an existing note.",
  "properties": {
    "type": {
      "const": "note.append_section",
      "title": "Type",
      "type": "string"
    },
    "path": {
      "description": "Note path, relative to the sink's root.",
      "maxLength": 1024,
      "pattern": "^[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254}(/[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254})*$",
      "title": "Path",
      "type": "string"
    },
    "heading": {
      "description": "Heading of the appended section, without the leading `#` characters.",
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Heading",
      "type": "string"
    },
    "content": {
      "description": "Section body (Markdown), at most 1 MiB.",
      "maxLength": 1048576,
      "title": "Content",
      "type": "string"
    }
  },
  "required": [
    "type",
    "path",
    "heading",
    "content"
  ],
  "title": "Horae intent note.append_section",
  "type": "object"
}
