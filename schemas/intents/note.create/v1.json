{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/intents/note.create/v1.json",
  "additionalProperties": false,
  "description": "Create a note with the given content.",
  "properties": {
    "type": {
      "const": "note.create",
      "title": "Type",
      "type": "string"
    },
    "path": {
      "description": "Note path, relative to the sink's root.",
      "maxLength": 1024,
      "pattern": "^[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254}(/[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254})*$",
      "title": "Path",
      "type": "string"
    },
    "content": {
      "description": "Full note content (Markdown), at most 1 MiB.",
      "maxLength": 1048576,
      "title": "Content",
      "type": "string"
    }
  },
  "required": [
    "type",
    "path",
    "content"
  ],
  "title": "Horae intent note.create",
  "type": "object"
}
