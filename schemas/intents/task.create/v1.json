{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/intents/task.create/v1.json",
  "additionalProperties": false,
  "description": "Create a task.",
  "if": {
    "properties": {
      "time": {
        "type": "string"
      }
    },
    "required": [
      "time"
    ]
  },
  "properties": {
    "type": {
      "const": "task.create",
      "title": "Type",
      "type": "string"
    },
    "title": {
      "description": "Task text: one line, at most 500 characters.",
      "maxLength": 500,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Title",
      "type": "string"
    },
    "fingerprint": {
      "description": "Stable identity used to deduplicate tasks across runs and sources.",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "due": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Due date (ISO 8601 `YYYY-MM-DD`).",
      "title": "Due"
    },
    "time": {
      "anyOf": [
        {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reminder time on the due date, `HH:MM` (24 h). Requires `due`.",
      "title": "Time"
    },
    "link": {
      "anyOf": [
        {
          "maxLength": 2048,
          "pattern": "^https://[^\\x00-\\x20\\x7f-\\xa0\\xad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890\\u0891\\u08e2\\u1680\\u180e\\u2000-\\u200f\\u2028-\\u202f\\u205f-\\u2064\\u2066-\\u206f\\u3000\\ufeff\\ufff9-\\ufffb/?#@\\\\%\\[\\]]+([/?#][^\\x00-\\x20\\x7f-\\xa0\\xad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890\\u0891\\u08e2\\u1680\\u180e\\u2000-\\u200f\\u2028-\\u202f\\u205f-\\u2064\\u2066-\\u206f\\u3000\\ufeff\\ufff9-\\ufffb\\\\]*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional `https://` link to the item the task comes from (no user info), routed only\nunder the `tasks` entry's trusted `link_prefix`.",
      "title": "Link"
    }
  },
  "required": [
    "type",
    "title",
    "fingerprint"
  ],
  "then": {
    "properties": {
      "due": {
        "type": "string"
      }
    },
    "required": [
      "due"
    ]
  },
  "title": "Horae intent task.create",
  "type": "object"
}
