{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horae.dev/schemas/intents/task.create/v1.json",
  "additionalProperties": false,
  "description": "Create a task.",
  "properties": {
    "type": {
      "const": "task.create",
      "title": "Type",
      "type": "string"
    },
    "title": {
      "description": "Task text.",
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "due": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Due date (ISO 8601 `YYYY-MM-DD`).",
      "title": "Due"
    },
    "time": {
      "anyOf": [
        {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reminder time on the due date, `HH:MM` (24 h).",
      "title": "Time"
    },
    "fingerprint": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stable identity used to deduplicate tasks across runs and sources.",
      "title": "Fingerprint"
    }
  },
  "required": [
    "type",
    "title"
  ],
  "title": "Horae intent task.create",
  "type": "object"
}
