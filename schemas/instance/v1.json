{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/instance/v1.json",
  "$defs": {
    "EnvSecretRef": {
      "additionalProperties": false,
      "description": "Read the secret from an environment variable.",
      "properties": {
        "env": {
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "EnvSecretRef",
      "type": "object"
    },
    "FileSecretRef": {
      "additionalProperties": false,
      "description": "Read the secret from a file in the secrets directory (Docker or Compose secrets).",
      "properties": {
        "file": {
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$",
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "FileSecretRef",
      "type": "object"
    },
    "ModelAlias": {
      "additionalProperties": false,
      "description": "What a model alias resolves to.",
      "properties": {
        "backend": {
          "description": "The backend adapter.",
          "enum": [
            "claude-cli",
            "anthropic",
            "openai-compatible",
            "ollama"
          ],
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "description": "The concrete model name for that backend.",
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x20\\x7f]+$",
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "not": {
                "pattern": "^https://([^/?:]*\\.)?localhost([:/?]|$)"
              },
              "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z]([a-z0-9-]{0,61}[a-z0-9])?(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?([/?][^\\x00-\\x20\\x7f\\\\#]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Endpoint for `openai-compatible` and `ollama` backends (https only).",
          "title": "Base Url"
        },
        "secret": {
          "anyOf": [
            {
              "maxLength": 128,
              "not": {
                "pattern": "^(HORAE(_|$)|LD_|DYLD_|PYTHON|PATH$|HOME$)"
              },
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The secret holding the backend's API key or token, e.g. `ANTHROPIC_API_KEY`.",
          "title": "Secret"
        }
      },
      "required": [
        "backend",
        "model"
      ],
      "title": "ModelAlias",
      "type": "object"
    },
    "PluginSettings": {
      "additionalProperties": false,
      "description": "Instance settings for one installed plugin (it must be in `horae.lock`).",
      "properties": {
        "startup_timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds the plugin may take to start. When omitted, the core default applies.",
          "title": "Startup Timeout S"
        },
        "call_timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds one tool call may take. When omitted, the core default applies.",
          "title": "Call Timeout S"
        }
      },
      "title": "PluginSettings",
      "type": "object"
    },
    "SchedulerConfig": {
      "additionalProperties": false,
      "description": "How pipelines with a `trigger` are started.",
      "properties": {
        "mode": {
          "default": "builtin",
          "description": "`builtin`: Horae's own cron. `external`: triggers are ignored and an external scheduler\n(Coolify, systemd, cron) calls `horae run <pipeline>`.",
          "enum": [
            "builtin",
            "external"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "SchedulerConfig",
      "type": "object"
    },
    "SecretsConfig": {
      "additionalProperties": false,
      "description": "Where secret values are read from.",
      "properties": {
        "dir": {
          "default": "/run/secrets",
          "description": "Directory of secret files.",
          "maxLength": 1024,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Dir",
          "type": "string"
        },
        "refs": {
          "description": "Explicit sources, by secret name. A secret without one is read from the environment\nvariable of the same name, else from the file of the same name in `dir`.",
          "maxProperties": 256,
          "patternProperties": {
            "^[A-Z][A-Z0-9_]*$": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EnvSecretRef"
                },
                {
                  "$ref": "#/$defs/FileSecretRef"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "not": {
              "pattern": "^(HORAE(_|$)|LD_|DYLD_|PYTHON|PATH$|HOME$)"
            }
          },
          "title": "Refs",
          "type": "object",
          "additionalProperties": false
        }
      },
      "title": "SecretsConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An instance's `horae.yaml`.",
  "properties": {
    "timezone": {
      "default": "UTC",
      "description": "Default IANA time zone for triggers and run contexts.",
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]{0,63}(/[A-Za-z0-9_+-]{1,64}){0,3}$",
      "title": "Timezone",
      "type": "string"
    },
    "state_dir": {
      "default": "state",
      "description": "The state directory (SQLite store, run records).",
      "maxLength": 1024,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "State Dir",
      "type": "string"
    },
    "models": {
      "description": "Model aliases, by name.",
      "maxProperties": 256,
      "patternProperties": {
        "^[a-z][a-z0-9._-]*$": {
          "$ref": "#/$defs/ModelAlias"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Models",
      "type": "object",
      "additionalProperties": false
    },
    "plugins": {
      "description": "Per-plugin settings, by plugin name.",
      "maxProperties": 256,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/PluginSettings"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Plugins",
      "type": "object",
      "additionalProperties": false
    },
    "secrets": {
      "$ref": "#/$defs/SecretsConfig"
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig"
    }
  },
  "title": "Horae instance configuration (horae.yaml)",
  "type": "object"
}
