{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/skill/v1.json",
  "additionalProperties": false,
  "description": "A skill's `skill.yaml`.",
  "properties": {
    "name": {
      "description": "The skill, `<namespace>/<skill>`; its folder is `skills/<namespace>/<skill>/`.",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9_-]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "description": "Skill version (semver). Part of the LLM cache key, with a digest of the files.",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "description": "One line, at most 500 characters.",
      "maxLength": 500,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Description",
      "type": "string"
    },
    "input_view": {
      "anyOf": [
        {
          "items": {
            "maxLength": 256,
            "pattern": "^([A-Za-z_][A-Za-z0-9_-]*|\\[\\])(\\.[A-Za-z_][A-Za-z0-9_-]*|\\[\\])*$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        {
          "maxProperties": 256,
          "minProperties": 1,
          "patternProperties": {
            "^([A-Za-z_][A-Za-z0-9_-]*|\\[\\])(\\.[A-Za-z_][A-Za-z0-9_-]*|\\[\\])*$": {
              "anyOf": [
                {
                  "maxProperties": 16,
                  "patternProperties": {
                    "^[A-Za-z_][A-Za-z0-9_-]*$": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "maxLength": 500,
                          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                          "type": "string"
                        },
                        {
                          "items": {
                            "anyOf": [
                              {
                                "type": "integer"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "maxLength": 500,
                                "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                                "type": "string"
                              }
                            ]
                          },
                          "maxItems": 64,
                          "type": "array"
                        }
                      ]
                    }
                  },
                  "properties": {
                    "class": {
                      "enum": [
                        "person",
                        "email",
                        "phone",
                        "place",
                        "amount",
                        "free_text"
                      ]
                    }
                  },
                  "propertyNames": {
                    "maxLength": 64
                  },
                  "type": "object",
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 256
          },
          "type": "object",
          "additionalProperties": false
        }
      ],
      "description": "The only fields of the step input the model sees (an allow-list): a list of paths, or a\nmapping `path: {options}` (`class`: de-identification before a cloud model, #34).",
      "title": "Input View"
    },
    "prompt": {
      "default": "prompt.md",
      "description": "The prompt file, in the skill folder.",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
      "title": "Prompt",
      "type": "string"
    },
    "output_schema": {
      "default": "output.schema.json",
      "description": "The output JSON Schema file, in the skill folder.",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
      "title": "Output Schema",
      "type": "string"
    },
    "intents": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "note.create",
              "note.append_section",
              "note.replace_owned_block",
              "task.create",
              "task.update_status",
              "notify.push",
              "http.post"
            ],
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        {
          "additionalProperties": {
            "maximum": 256,
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "note.create",
              "note.append_section",
              "note.replace_owned_block",
              "task.create",
              "task.update_status",
              "notify.push",
              "http.post"
            ]
          },
          "type": "object"
        }
      ],
      "description": "Intents the skill may propose, a list of types or a mapping `type: max` (at most `max`\nper step): within the shipping plugin's `permissions.intents` (checked by the loader).\nEmpty means the skill proposes none.",
      "title": "Intents"
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "input_view"
  ],
  "title": "Horae skill (skill.yaml)",
  "type": "object"
}
