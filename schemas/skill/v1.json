{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/skill/v1.json",
  "$defs": {
    "TaskFingerprintRule": {
      "additionalProperties": false,
      "description": "Where the ids behind a `task.create` fingerprint live in the viewed input (decision 67).\n\nA `task.create` the skill proposes must carry the fingerprint `prefix` + an id found at\n`ids` in the viewed input; any other fingerprint is a guard violation.",
      "properties": {
        "ids": {
          "description": "A path of the skill's `input_view` (or below one) whose string values are the ids, e.g.\n`[].data.needs_interpretation[].id`. A list of strings is read as its elements.",
          "maxLength": 256,
          "pattern": "^([A-Za-z_][A-Za-z0-9_-]*|\\[\\])(\\.[A-Za-z_][A-Za-z0-9_-]*|\\[\\])*$",
          "title": "Ids",
          "type": "string"
        },
        "prefix": {
          "description": "What the fingerprint puts before the id, e.g. `gmail:`.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:-]{1,64}$",
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "ids",
        "prefix"
      ],
      "title": "TaskFingerprintRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A skill's `skill.yaml`.",
  "properties": {
    "name": {
      "description": "The skill, `<namespace>/<skill>`; its folder is `skills/<namespace>/<skill>/`.",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9_-]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "description": "Skill version (semver). Part of the LLM cache key, with a digest of the files.",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "description": "One line, at most 500 characters.",
      "maxLength": 500,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Description",
      "type": "string"
    },
    "input_view": {
      "anyOf": [
        {
          "items": {
            "maxLength": 256,
            "pattern": "^([A-Za-z_][A-Za-z0-9_-]*|\\[\\])(\\.[A-Za-z_][A-Za-z0-9_-]*|\\[\\])*$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        {
          "maxProperties": 256,
          "minProperties": 1,
          "patternProperties": {
            "^([A-Za-z_][A-Za-z0-9_-]*|\\[\\])(\\.[A-Za-z_][A-Za-z0-9_-]*|\\[\\])*$": {
              "anyOf": [
                {
                  "maxProperties": 16,
                  "patternProperties": {
                    "^[A-Za-z_][A-Za-z0-9_-]*$": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "maxLength": 500,
                          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                          "type": "string"
                        },
                        {
                          "items": {
                            "anyOf": [
                              {
                                "type": "integer"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "maxLength": 500,
                                "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                                "type": "string"
                              }
                            ]
                          },
                          "maxItems": 64,
                          "type": "array"
                        }
                      ]
                    }
                  },
                  "properties": {
                    "class": {
                      "enum": [
                        "person",
                        "email",
                        "phone",
                        "place",
                        "amount",
                        "free_text"
                      ]
                    }
                  },
                  "propertyNames": {
                    "maxLength": 64
                  },
                  "type": "object",
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 256
          },
          "type": "object",
          "additionalProperties": false
        }
      ],
      "description": "The only fields of the step input the model sees (an allow-list): a list of paths, or a\nmapping `path: {options}` (`class`: de-identification before a cloud model, #34).",
      "title": "Input View"
    },
    "prompt": {
      "default": "prompt.md",
      "description": "The prompt file, in the skill folder.",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
      "title": "Prompt",
      "type": "string"
    },
    "output_schema": {
      "default": "output.schema.json",
      "description": "The output JSON Schema file, in the skill folder.",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
      "title": "Output Schema",
      "type": "string"
    },
    "intents": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "note.create",
              "note.append_section",
              "note.replace_owned_block",
              "task.create",
              "task.update_status",
              "notify.push",
              "http.post"
            ],
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        {
          "additionalProperties": {
            "maximum": 256,
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "note.create",
              "note.append_section",
              "note.replace_owned_block",
              "task.create",
              "task.update_status",
              "notify.push",
              "http.post"
            ]
          },
          "type": "object"
        }
      ],
      "description": "Intents the skill may propose, a list of types or a mapping `type: max` (at most `max`\nper step): within the shipping plugin's `permissions.intents` (checked by the loader).\nEmpty means the skill proposes none.",
      "title": "Intents"
    },
    "links": {
      "default": "input",
      "description": "Links in the skill's note text: `input` (only URLs of the viewed input, the default) or\n`none` (no link, autolink or bare URL at all; schemas decision 55).",
      "enum": [
        "input",
        "none"
      ],
      "title": "Links",
      "type": "string"
    },
    "task_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskFingerprintRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Opt-in (decision 67): a `task.create` the skill proposes must carry the fingerprint\n`prefix` + an id read at `ids` in the viewed input. Omitted: a `task.create` fingerprint is\nfree text, as before. Requires `task.create` in `intents`."
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "input_view"
  ],
  "title": "Horae skill (skill.yaml)",
  "type": "object"
}
