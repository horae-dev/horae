{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/intent/v1.json",
  "$defs": {
    "HttpPost": {
      "additionalProperties": false,
      "description": "POST a JSON body to an https URL.\n\nThe core checks `url_host(url)` against the proposer's `permissions.network`, using\nexactly that parsed host (any port is allowed on a declared host), and caps the compact\nJSON body at 1 MiB (`horae.intents`). The sink must never follow redirects, or must\nre-check the host of every hop with `url_host` against the same list.",
      "properties": {
        "type": {
          "const": "http.post",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "description": "Target URL: https only, a host name (no IP literal), optional port.",
          "maxLength": 2048,
          "not": {
            "pattern": "^https://([^/?:]*\\.)?localhost([:/?]|$)"
          },
          "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z]([a-z0-9-]{0,61}[a-z0-9])?(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?([/?][^\\x00-\\x20\\x7f\\\\#]*)?$",
          "title": "Url",
          "type": "string"
        },
        "body": {
          "description": "JSON request body.",
          "title": "Body"
        }
      },
      "required": [
        "type",
        "url",
        "body"
      ],
      "title": "HttpPost",
      "type": "object"
    },
    "NoteAppendSection": {
      "additionalProperties": false,
      "description": "Append a section, under a heading, to an existing note.",
      "properties": {
        "type": {
          "const": "note.append_section",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "description": "Note path, relative to the sink's root.",
          "maxLength": 1024,
          "pattern": "^[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254}(/[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254})*$",
          "title": "Path",
          "type": "string"
        },
        "heading": {
          "description": "Heading of the appended section, without the leading `#` characters.",
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Heading",
          "type": "string"
        },
        "content": {
          "description": "Section body (Markdown), at most 1 MiB.",
          "maxLength": 1048576,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "heading",
        "content"
      ],
      "title": "NoteAppendSection",
      "type": "object"
    },
    "NoteCreate": {
      "additionalProperties": false,
      "description": "Create a note with the given content.",
      "properties": {
        "type": {
          "const": "note.create",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "description": "Note path, relative to the sink's root.",
          "maxLength": 1024,
          "pattern": "^[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254}(/[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254})*$",
          "title": "Path",
          "type": "string"
        },
        "content": {
          "description": "Full note content (Markdown), at most 1 MiB.",
          "maxLength": 1048576,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "content"
      ],
      "title": "NoteCreate",
      "type": "object"
    },
    "NoteReplaceOwnedBlock": {
      "additionalProperties": false,
      "description": "Replace the content of a block that Horae owns inside a note.",
      "properties": {
        "type": {
          "const": "note.replace_owned_block",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "description": "Note path, relative to the sink's root.",
          "maxLength": 1024,
          "pattern": "^[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254}(/[^/\\\\\\x00-\\x1f\\x7f.][^/\\\\\\x00-\\x1f\\x7f]{0,254})*$",
          "title": "Path",
          "type": "string"
        },
        "block": {
          "description": "Identifier of the owned block to replace.",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Block",
          "type": "string"
        },
        "content": {
          "description": "New block content (Markdown), at most 1 MiB.",
          "maxLength": 1048576,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "block",
        "content"
      ],
      "title": "NoteReplaceOwnedBlock",
      "type": "object"
    },
    "NotifyAction": {
      "additionalProperties": false,
      "description": "A notification button that changes one task once, through a signed `/act` link the\ncore mints when it sends the notification (#38). The proposer names the task and the\nkind; it never sees or writes a URL, nor the button's text: the core labels each button\nfrom its kind and duration (`Done`, `Snooze 1h`, `Snooze 3h`, `Tomorrow`).",
      "else": {
        "properties": {
          "duration": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "task.snooze"
          }
        }
      },
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deprecated and **ignored** (#38, schemas decision 54 B): the core labels each button\nfrom its kind and duration, so a button's text always says what it does. Still accepted\n(one line, at most 64 characters, no control character) so that proposals written with\nit stay valid.",
          "title": "Label"
        },
        "kind": {
          "description": "What the button does.",
          "enum": [
            "task.done",
            "task.snooze"
          ],
          "title": "Kind",
          "type": "string"
        },
        "task": {
          "description": "The task's fingerprint: like a `task.update_status` target, it must appear in the data\nthe run collected (rule 4 of `horae.engine.executor`).",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Task",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "enum": [
                "1h",
                "3h",
                "tomorrow"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For `task.snooze` only (and then required).",
          "title": "Duration"
        }
      },
      "required": [
        "kind",
        "task"
      ],
      "then": {
        "properties": {
          "duration": {
            "type": "string"
          }
        },
        "required": [
          "duration"
        ]
      },
      "title": "NotifyAction",
      "type": "object"
    },
    "NotifyPush": {
      "additionalProperties": false,
      "description": "Send a push notification.",
      "properties": {
        "type": {
          "const": "notify.push",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 500,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional notification title: one line, at most 500 characters.",
          "title": "Title"
        },
        "body": {
          "description": "Notification text, at most 4096 characters.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "link": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^(https|obsidian)://[^\\x00-\\x20\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional `https://` or `obsidian://` link opened when the notification is tapped.",
          "title": "Link"
        },
        "actions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/NotifyAction"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional buttons (at most 3), each changing one task once through `/act` (#38). The\ncore mints their links when it sends the notification; without the `/act` key or\n`http.public_url` the notification is sent without them.",
          "title": "Actions"
        }
      },
      "required": [
        "type",
        "body"
      ],
      "title": "NotifyPush",
      "type": "object"
    },
    "TaskCreate": {
      "additionalProperties": false,
      "description": "Create a task.",
      "if": {
        "properties": {
          "time": {
            "type": "string"
          }
        },
        "required": [
          "time"
        ]
      },
      "properties": {
        "type": {
          "const": "task.create",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "description": "Task text: one line, at most 500 characters.",
          "maxLength": 500,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Title",
          "type": "string"
        },
        "fingerprint": {
          "description": "Stable identity used to deduplicate tasks across runs and sources.",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "due": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Due date (ISO 8601 `YYYY-MM-DD`).",
          "title": "Due"
        },
        "time": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reminder time on the due date, `HH:MM` (24 h). Requires `due`.",
          "title": "Time"
        },
        "link": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https://[^\\x00-\\x20\\x7f-\\xa0\\xad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890\\u0891\\u08e2\\u1680\\u180e\\u2000-\\u200f\\u2028-\\u202f\\u205f-\\u2064\\u2066-\\u206f\\u3000\\ufeff\\ufff9-\\ufffb/?#@\\\\%\\[\\]]+([/?#][^\\x00-\\x20\\x7f-\\xa0\\xad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890\\u0891\\u08e2\\u1680\\u180e\\u2000-\\u200f\\u2028-\\u202f\\u205f-\\u2064\\u2066-\\u206f\\u3000\\ufeff\\ufff9-\\ufffb\\\\]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional `https://` link to the item the task comes from (no user info), routed only\nunder the `tasks` entry's trusted `link_prefix`.",
          "title": "Link"
        }
      },
      "required": [
        "type",
        "title",
        "fingerprint"
      ],
      "then": {
        "properties": {
          "due": {
            "type": "string"
          }
        },
        "required": [
          "due"
        ]
      },
      "title": "TaskCreate",
      "type": "object"
    },
    "TaskUpdateStatus": {
      "additionalProperties": false,
      "description": "Change the status of an existing task.",
      "else": {
        "properties": {
          "until": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "snoozed"
          }
        },
        "required": [
          "status"
        ]
      },
      "properties": {
        "type": {
          "const": "task.update_status",
          "title": "Type",
          "type": "string"
        },
        "task": {
          "description": "The task's fingerprint.",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Task",
          "type": "string"
        },
        "status": {
          "description": "New status.",
          "enum": [
            "todo",
            "done",
            "cancelled",
            "snoozed"
          ],
          "title": "Status",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For `snoozed` only (and then required): when the task comes back.",
          "title": "Until"
        }
      },
      "required": [
        "type",
        "task",
        "status"
      ],
      "then": {
        "properties": {
          "until": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "until"
        ]
      },
      "title": "TaskUpdateStatus",
      "type": "object"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/NoteCreate"
    },
    {
      "$ref": "#/$defs/NoteAppendSection"
    },
    {
      "$ref": "#/$defs/NoteReplaceOwnedBlock"
    },
    {
      "$ref": "#/$defs/TaskCreate"
    },
    {
      "$ref": "#/$defs/TaskUpdateStatus"
    },
    {
      "$ref": "#/$defs/NotifyPush"
    },
    {
      "$ref": "#/$defs/HttpPost"
    }
  ],
  "title": "Horae intent (any)"
}
