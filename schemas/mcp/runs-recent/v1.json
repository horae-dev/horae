{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/horae-dev/horae/main/schemas/mcp/runs-recent/v1.json",
  "$defs": {
    "McpCost": {
      "additionalProperties": false,
      "properties": {
        "usd": {
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        },
        "tokens_in": {
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "required": [
        "usd",
        "tokens_in",
        "tokens_out"
      ],
      "title": "McpCost",
      "type": "object"
    },
    "McpRun": {
      "additionalProperties": false,
      "description": "One run as `horae runs --json` and the HTTP API's `/runs` show it\n(`horae.run_view.run_json`): the indexed columns, never the record.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "pipeline": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Pipeline",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "ok",
            "noop",
            "degraded",
            "failed",
            "undone"
          ],
          "title": "Status",
          "type": "string"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "abandoned": {
          "title": "Abandoned",
          "type": "boolean"
        },
        "started_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration S"
        },
        "cost": {
          "$ref": "#/$defs/McpCost"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string",
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ],
          "description": "UNTRUSTED. Why the run failed, as a plugin or the core worded it (clipped).",
          "title": "Error"
        }
      },
      "required": [
        "id",
        "pipeline",
        "status",
        "stale",
        "dry_run",
        "abandoned",
        "started_at",
        "finished_at",
        "duration_s",
        "cost",
        "error"
      ],
      "title": "McpRun",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result of `runs.recent`: the latest runs, newest first.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/McpRun"
      },
      "maxItems": 50,
      "title": "Runs",
      "type": "array"
    },
    "truncated": {
      "description": "There are older runs than the ones listed.",
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "runs",
    "truncated"
  ],
  "title": "Horae MCP tool result: runs.recent",
  "type": "object"
}
