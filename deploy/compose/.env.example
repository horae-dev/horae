# Copy to .env (next to docker-compose.yaml) and edit. Never commit .env or the secrets.
# Guide: docs/operations/compose.md.

# Image tag: empty uses the default of docker-compose.yaml (`x-horae-image`, the one place it
# is written). Or a `sha-<short>` of main, a release `X.Y.Z`; `<tag>@sha256:<digest>` pins the
# digest too (recommended in production).
HORAE_IMAGE_TAG=

# Required: a directory of secret files, one per secret named after it (for example
# secrets/ANTHROPIC_API_KEY), mounted read-only on /run/secrets. Readable by uid 10001.
HORAE_SECRETS_DIR=./secrets

# builtin (horae serve fires the cron triggers) or external (host cron runs `horae run`).
HORAE_SCHEDULER=builtin

# Loopback port of the API on the host (bound to 127.0.0.1 only).
HORAE_LOCAL_PORT=8080

# Host names a proxy serves Horae on, space-separated (loopback is always allowed).
# With traefik.yaml this is set from HORAE_PUBLIC_HOST instead.
HORAE_ALLOWED_HOSTS=

# --- traefik.yaml only ---
# Required there: the public host name, and the SSO provider's forwardAuth address.
HORAE_PUBLIC_HOST=horae.example.test
HORAE_SSO_FORWARD_AUTH_URL=http://authentik-server:9000/outpost.goauthentik.io/auth/traefik
# A network shared only by Horae and Traefik (docker network create --internal horae-proxy).
HORAE_PROXY_NETWORK=horae-proxy
HORAE_TRAEFIK_ENTRYPOINT=websecure
HORAE_TRAEFIK_CERTRESOLVER=letsencrypt
